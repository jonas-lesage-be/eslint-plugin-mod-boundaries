{
  "name": "@jonas-lesage-be/eslint-plugin-mod-boundaries",
  "version": "0.1.2",
  "description": "An ESLint plugin to enforce module boundaries using module files.",
  "author": "Jonas Lesage <jonas.lesage@outlook.com>",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "nodeModulesDir": "auto",
  "publish": {
    "include": ["mod.ts", "src/**/*.ts", "deno.json", "README.md", "LICENSE"]
  },
  "imports": {
    "@/": "./src/",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@e18e/eslint-plugin": "npm:@e18e/eslint-plugin@^0.8.0",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@eslint/json": "npm:@eslint/json@^2.1.0",
    "@eslint/markdown": "npm:@eslint/markdown@^8.0.3",
    "estree": "npm:@types/estree@^1.0.9",
    "@typescript-eslint/utils": "npm:@typescript-eslint/utils@^8.70.0",
    "eslint": "npm:eslint@^10.10.0",
    "eslint-plugin-eslint-plugin": "npm:eslint-plugin-eslint-plugin@^7.6.2",
    "eslint-plugin-jsdoc": "npm:eslint-plugin-jsdoc@^64.3.6",
    "eslint-plugin-perfectionist": "npm:eslint-plugin-perfectionist@^5.11.0",
    "eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^4.2.0",
    "eslint-plugin-unicorn": "npm:eslint-plugin-unicorn@^74.0.0",
    "pino": "npm:pino@^10.3.1",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "prettier": "npm:prettier@^3.9.6",
    "typescript-eslint": "npm:typescript-eslint@^8.70.0"
  }
}
